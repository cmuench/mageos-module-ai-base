<?xml version="1.0"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <!--
                    Where every configuration section's resource lives, Magento_Config::config
                    ("Stores > Settings > Configuration" in the role tree). This resource guards
                    provider credentials and the outbound Test Connection and Refresh Models
                    requests, so it must only come with the permission to edit configuration, not
                    with anything a merchandiser role is routinely given, such as Attributes.

                    Only the position changed, never the id: a role's grant is stored against the
                    id, so roles that already had it keep it.
                -->
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="MageOS_AiBase::configuration"
                                      title="Mage-OS AI Configuration"
                                      translate="title"
                                      sortOrder="30"/>
                        </resource>
                    </resource>
                </resource>
                <!--
                    The AI reports live under Reports rather than beside the configuration
                    resource: they are what the store spent, not how the providers are set up, and
                    a role tree reads best when a permission lives where its menu item does.

                    Nested inside Magento_Backend::admin, which is where Magento_Reports itself
                    declares Magento_Reports::report. An acl.xml naming an existing resource at a
                    different point in the tree does not move it — every file's resources are merged
                    into one document under a unique-id constraint, so the second position is a
                    duplicate and the whole merged ACL fails to build, taking the admin with it.

                    The group resource exists so the menu heading has something to be guarded by,
                    and so a role can be given or refused every AI report at once as more are
                    added, rather than one checkbox per report.
                -->
                <resource id="Magento_Reports::report">
                    <resource id="MageOS_AiBase::reports"
                              title="Mage-OS AI"
                              translate="title"
                              sortOrder="90">
                        <resource id="MageOS_AiBase::usage"
                                  title="Mage-OS AI Usage"
                                  translate="title"
                                  sortOrder="10"/>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
